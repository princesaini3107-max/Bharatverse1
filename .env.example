# ---- BharatVerse backend configuration ----
# Copy this file to  server/.env  (optional — sensible defaults are built in).

# Port the Express API listens on
PORT=5000

# Secret used to sign demo JWTs. Change it for anything beyond local demo.
JWT_SECRET=bharatverse_demo_secret_change_me

# ---- Optional local LLM (Ollama) for the AI Cultural Guide ----
# The app works WITHOUT this: it falls back to a grounded, retrieval-based
# "demo mode" answer. To use a real local model, install Ollama
# (https://ollama.com), run e.g.  `ollama pull llama3.2`  then set:
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Leave OLLAMA_URL blank to force demo mode.
